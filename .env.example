# PostgreSQL Database Connection URL (Supabase Transaction Pooler / Direct)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?sslmode=verify-full"

# Admin Authentication Session Secret (Optional - random fallback is generated if omitted)
ADMIN_SESSION_SECRET="your-admin-session-secret-at-least-32-chars"

# Optional: Vercel Blob Storage Token for Production Image Uploads
BLOB_READ_WRITE_TOKEN=""

# Supabase Public Keys (if client-side Supabase features are used)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
