// Prisma Schema for ADYK CARDEX Production Database
// PostgreSQL Data Architecture

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectStatus {
  BUILDING
  COMPLETED
  OPEN_SOURCE
  ARCHIVED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  DECLINED
}

enum AvailabilityStatus {
  OPEN_TO_CONNECT
  OPEN_FOR_COLLABORATION
  CURRENTLY_BUILDING
  NOT_CURRENTLY_AVAILABLE
}

enum CollaborationRole {
  FRONTEND_DEVELOPER
  BACKEND_DEVELOPER
  MOBILE_DEVELOPER
  AIML_DEVELOPER
  UIUX_DESIGNER
  HARDWARE_IOT_DEVELOPER
  TESTER
  OTHER
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

model Admin {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         AdminRole  @default(ADMIN)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?

  reviewedProjects Project[]

  @@index([email])
}

model Developer {
  id                    String             @id @default(uuid())
  username              String             @unique
  name                  String
  role                  String
  bio                   String             @db.Text
  avatarUrl             String?
  availability          AvailabilityStatus @default(OPEN_TO_CONNECT)
  collaborationPreference String?          @db.Text
  location              String?
  githubUrl             String?
  linkedInUrl           String?
  portfolioUrl          String?
  whatsApp              String?            // Private, encrypted or protected
  allowWhatsAppContact  Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  skills                DeveloperSkill[]
  projects              Project[]
}

model Project {
  id                    String            @id @default(uuid())
  slug                  String            @unique
  title                 String
  tagline               String?
  description           String            @db.Text
  category              String
  imageUrl              String            // External CDN/Object storage URL
  demoVideoUrl          String?
  githubUrl             String?
  liveDemoUrl           String?
  problemSolved         String?           @db.Text
  howItWorks            String?           @db.Text
  
  status                ProjectStatus     @default(BUILDING)
  submissionStatus      SubmissionStatus  @default(PENDING)
  adminNotes            String?           @db.Text
  
  collaborationOpen     Boolean           @default(false)
  
  // Creator relationship & safe fields
  creatorId             String?
  creator               Developer?        @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  creatorName           String
  creatorUsername       String
  creatorEmail          String            // Strictly private, admin & notifications only
  creatorWhatsApp       String?           // Strictly private unless opted in
  allowWhatsAppContact  Boolean           @default(false)
  creatorLinkedIn       String?
  creatorGitHub         String?
  creatorWebsite        String?

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  reviewedAt            DateTime?
  reviewedById          String?
  reviewedBy            Admin?            @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  technologies          ProjectTechnology[]
  collaborationNeeds    CollaborationNeed[]

  @@index([slug])
  @@index([submissionStatus])
  @@index([status])
  @@index([category])
}

model Technology {
  id          String              @id @default(uuid())
  name        String              @unique
  slug        String              @unique
  category    String?
  icon        String?

  projects    ProjectTechnology[]
  developers  DeveloperSkill[]
}

model ProjectTechnology {
  projectId    String
  technologyId String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
}

model DeveloperSkill {
  developerId  String
  technologyId String
  developer    Developer  @relation(fields: [developerId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([developerId, technologyId])
}

model CollaborationNeed {
  id        String            @id @default(uuid())
  projectId String
  role      CollaborationRole
  details   String?
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}
